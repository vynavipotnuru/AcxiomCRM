@model AcxiomCRM.Application.DTOs.PagedResult<AcxiomCRM.Application.DTOs.OpportunityDto>
@{
    ViewData["Title"] = "Opportunity Management";
    var searchTerm = ViewBag.SearchTerm as string;
    var currentStage = ViewBag.Stage as OpportunityStage?;
    var currentStatus = ViewBag.Status as OpportunityStatus?;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">Opportunities</h3>
        <p class="text-muted small mb-0">Track active deals, probability forecasting, and pipeline stages.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Pipeline" class="btn btn-outline-primary">
            <i class="bi bi-kanban me-1"></i> Pipeline Board
        </a>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i> Add Opportunity
        </a>
    </div>
</div>

<!-- Search & Filter Card -->
<div class="card mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="searchTerm" value="@searchTerm" class="form-control border-start-0" placeholder="Search opportunity, customer..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="stage" class="form-select" onchange="this.form.submit()">
                    <option value="">All Stages</option>
                    @foreach (OpportunityStage s in Enum.GetValues(typeof(OpportunityStage)))
                    {
                        <option value="@s" selected="@(currentStage == s)">@s</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select name="status" class="form-select" onchange="this.form.submit()">
                    <option value="">All Statuses</option>
                    @foreach (OpportunityStatus st in Enum.GetValues(typeof(OpportunityStatus)))
                    {
                        <option value="@st" selected="@(currentStatus == st)">@st</option>
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-secondary"><i class="bi bi-funnel me-1"></i> Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Opportunities Table -->
<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Opportunity</th>
                        <th>Customer</th>
                        <th>Amount (₹)</th>
                        <th>Probability</th>
                        <th>Weighted Value</th>
                        <th>Stage</th>
                        <th>Close Date</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Any())
                    {
                        @foreach (var o in Model.Items)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold text-dark">@o.OpportunityName</div>
                                    <div class="small text-muted">Created @o.CreatedDate.ToString("MMM dd, yyyy")</div>
                                </td>
                                <td>
                                    <span class="fw-medium">@(o.CustomerName ?? "Lead Conversion")</span>
                                </td>
                                <td class="fw-bold text-dark">₹@o.Amount.ToString("N0")</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="progress flex-grow-1" style="height: 6px; width: 60px;">
                                            <div class="progress-bar bg-primary" role="progressbar" style="width: @o.Probability%;"></div>
                                        </div>
                                        <span class="small fw-semibold">@o.Probability%</span>
                                    </div>
                                </td>
                                <td class="fw-semibold text-success">₹@o.WeightedPipeline.ToString("N0")</td>
                                <td>
                                    @switch (o.Stage)
                                    {
                                        case OpportunityStage.Qualification:
                                            <span class="badge bg-secondary-subtle text-secondary border">Qualification</span>
                                            break;
                                        case OpportunityStage.Proposal:
                                            <span class="badge bg-info-subtle text-info border">Proposal</span>
                                            break;
                                        case OpportunityStage.Negotiation:
                                            <span class="badge bg-warning-subtle text-warning border">Negotiation</span>
                                            break;
                                        case OpportunityStage.Won:
                                            <span class="badge bg-success-subtle text-success border">Won</span>
                                            break;
                                        case OpportunityStage.Lost:
                                            <span class="badge bg-danger-subtle text-danger border">Lost</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    <span class="small">@o.ExpectedCloseDate.ToString("MMM dd, yyyy")</span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@o.OpportunityId" class="btn btn-outline-secondary" title="Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@o.OpportunityId" class="btn btn-outline-secondary" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                                        {
                                            <form asp-action="Delete" asp-route-id="@o.OpportunityId" method="post" class="d-inline" onsubmit="return confirm('Delete this opportunity?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-danger" title="Delete">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-briefcase fs-2"></i>
                                <p class="mt-2 mb-0">No opportunities found matching current filters.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
            <span class="small text-muted">Showing page @Model.PageIndex of @Model.TotalPages (@Model.TotalCount total)</span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pageIndex="@(Model.PageIndex - 1)" asp-route-searchTerm="@searchTerm" asp-route-stage="@currentStage" asp-route-status="@currentStatus">Previous</a>
                </li>
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.PageIndex ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-pageIndex="@p" asp-route-searchTerm="@searchTerm" asp-route-stage="@currentStage" asp-route-status="@currentStatus">@p</a>
                    </li>
                }
                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pageIndex="@(Model.PageIndex + 1)" asp-route-searchTerm="@searchTerm" asp-route-stage="@currentStage" asp-route-status="@currentStatus">Next</a>
                </li>
            </ul>
        </div>
    }
</div>
