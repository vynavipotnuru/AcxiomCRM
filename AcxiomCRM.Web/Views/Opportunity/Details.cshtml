@model AcxiomCRM.Application.DTOs.OpportunityDto
@{
    ViewData["Title"] = $"Opportunity - {Model.OpportunityName}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h3 class="fw-bold mb-0">@Model.OpportunityName</h3>
            <span class="badge bg-primary-subtle text-primary border">@Model.Stage</span>
        </div>
        <p class="text-muted small mb-0 mt-1">
            <i class="bi bi-building me-1"></i>@(Model.CustomerName ?? "Lead Conversion") • Created on @Model.CreatedDate.ToString("MMM dd, yyyy")
        </p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="FollowUp" asp-action="Create" asp-route-opportunityId="@Model.OpportunityId" class="btn btn-sm btn-outline-primary">
            <i class="bi bi-calendar-plus me-1"></i> Schedule Follow-Up
        </a>
        <a asp-action="Edit" asp-route-id="@Model.OpportunityId" class="btn btn-sm btn-secondary">
            <i class="bi bi-pencil me-1"></i> Edit Deal
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white py-3">
                <h6 class="fw-bold mb-0"><i class="bi bi-cash-coin text-success me-2"></i>Financial & Pipeline Metrics</h6>
            </div>
            <div class="card-body">
                <ul class="list-unstyled mb-0">
                    <li class="mb-3">
                        <span class="text-muted small d-block">Deal Amount</span>
                        <h4 class="fw-bold text-dark my-1">₹@Model.Amount.ToString("N0")</h4>
                    </li>
                    <li class="mb-3">
                        <span class="text-muted small d-block">Win Probability</span>
                        <div class="d-flex align-items-center gap-2 mt-1">
                            <div class="progress flex-grow-1" style="height: 8px;">
                                <div class="progress-bar bg-primary" role="progressbar" style="width: @Model.Probability%;"></div>
                            </div>
                            <span class="fw-bold">@Model.Probability%</span>
                        </div>
                    </li>
                    <li class="mb-3">
                        <span class="text-muted small d-block">Weighted Pipeline Value (Amount × Probability / 100)</span>
                        <h5 class="fw-bold text-success my-1">₹@Model.WeightedPipeline.ToString("N0")</h5>
                    </li>
                    <li class="mb-3">
                        <span class="text-muted small d-block">Expected Close Date</span>
                        <span class="fw-medium">@Model.ExpectedCloseDate.ToString("MMMM dd, yyyy")</span>
                    </li>
                    <li class="mb-0">
                        <span class="text-muted small d-block">Notes</span>
                        <p class="small mb-0 text-secondary">@(string.IsNullOrEmpty(Model.Notes) ? "No notes recorded." : Model.Notes)</p>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>
