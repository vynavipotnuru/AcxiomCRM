@model List<AcxiomCRM.Application.DTOs.RoleDto>
@{
    ViewData["Title"] = "Security Roles & Permission Matrix";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">Roles & Access Control Matrix</h3>
        <p class="text-muted small mb-0">Role configurations, operational scopes, and server-side authorization boundaries.</p>
    </div>
    <a asp-controller="User" asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-people me-1"></i> Manage Users
    </a>
</div>

<!-- Role Definitions -->
<div class="row g-3 mb-4">
    @foreach (var r in Model)
    {
        <div class="col-md-4">
            <div class="card h-100 p-3 border-start border-4 @(r.Name == "Admin" ? "border-danger" : r.Name == "Manager" ? "border-primary" : "border-success")">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h5 class="fw-bold mb-0">@r.Name</h5>
                    <span class="badge @(r.Name == "Admin" ? "bg-danger" : r.Name == "Manager" ? "bg-primary" : "bg-success")">Role</span>
                </div>
                <p class="small text-muted mb-0">@(r.Description ?? "Standard security role with access boundaries.")</p>
            </div>
        </div>
    }
</div>

<!-- Suggested Permission Matrix -->
<div class="card shadow-sm">
    <div class="card-header bg-white py-3">
        <h6 class="fw-bold mb-0"><i class="bi bi-shield-lock text-primary me-2"></i>Permission Matrix (Enforced on Server)</h6>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-bordered align-middle mb-0 text-center">
                <thead class="table-light">
                    <tr>
                        <th class="text-start ps-4">Functional Module</th>
                        <th>Admin</th>
                        <th>Manager</th>
                        <th>Sales Executive</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="text-start ps-4 fw-semibold">Dashboard</td>
                        <td><span class="badge bg-success">Full System</span></td>
                        <td><span class="badge bg-primary">Team Scope</span></td>
                        <td><span class="badge bg-info text-dark">Own / Assigned</span></td>
                    </tr>
                    <tr>
                        <td class="text-start ps-4 fw-semibold">Customer Management</td>
                        <td><span class="badge bg-success">Full System</span></td>
                        <td><span class="badge bg-primary">Team Scope</span></td>
                        <td><span class="badge bg-info text-dark">Own / Assigned</span></td>
                    </tr>
                    <tr>
                        <td class="text-start ps-4 fw-semibold">Lead Management</td>
                        <td><span class="badge bg-success">Full System</span></td>
                        <td><span class="badge bg-primary">Team Scope</span></td>
                        <td><span class="badge bg-info text-dark">Own / Assigned</span></td>
                    </tr>
                    <tr>
                        <td class="text-start ps-4 fw-semibold">Opportunities & Pipeline</td>
                        <td><span class="badge bg-success">Full System</span></td>
                        <td><span class="badge bg-primary">Team Pipeline</span></td>
                        <td><span class="badge bg-info text-dark">Own / Assigned</span></td>
                    </tr>
                    <tr>
                        <td class="text-start ps-4 fw-semibold">Follow-Ups & Activities</td>
                        <td><span class="badge bg-success">Full System</span></td>
                        <td><span class="badge bg-primary">Team Scope</span></td>
                        <td><span class="badge bg-info text-dark">Own / Assigned</span></td>
                    </tr>
                    <tr>
                        <td class="text-start ps-4 fw-semibold">User Administration</td>
                        <td><span class="badge bg-success">Full Control</span></td>
                        <td><span class="badge bg-secondary">No Access</span></td>
                        <td><span class="badge bg-danger">Forbidden</span></td>
                    </tr>
                    <tr>
                        <td class="text-start ps-4 fw-semibold">Role Administration</td>
                        <td><span class="badge bg-success">Full Control</span></td>
                        <td><span class="badge bg-secondary">No Access</span></td>
                        <td><span class="badge bg-danger">Forbidden</span></td>
                    </tr>
                    <tr>
                        <td class="text-start ps-4 fw-semibold">Audit Log Viewer</td>
                        <td><span class="badge bg-success">Full System Log</span></td>
                        <td><span class="badge bg-primary">Operational View</span></td>
                        <td><span class="badge bg-danger">Forbidden</span></td>
                    </tr>
                    <tr>
                        <td class="text-start ps-4 fw-semibold">Reporting & Analytics</td>
                        <td><span class="badge bg-success">All Reports</span></td>
                        <td><span class="badge bg-primary">Management / Team</span></td>
                        <td><span class="badge bg-info text-dark">Own / Assigned</span></td>
                    </tr>
                    <tr>
                        <td class="text-start ps-4 fw-semibold">REST API Endpoints</td>
                        <td><span class="badge bg-success">All Endpoints</span></td>
                        <td><span class="badge bg-primary">Team Endpoints</span></td>
                        <td><span class="badge bg-info text-dark">Assigned Scope</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
