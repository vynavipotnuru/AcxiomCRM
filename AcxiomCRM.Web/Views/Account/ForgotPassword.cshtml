@model AcxiomCRM.Application.DTOs.ForgotPasswordDto
@{
    ViewData["Title"] = "Forgot Password";
}

<div class="row justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="col-md-5 col-lg-4">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h5 class="card-title fw-bold mb-2">Reset Password</h5>
                <p class="text-muted small mb-4">Enter your registered email address to receive password reset instructions.</p>

                <form asp-action="ForgotPassword" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-medium small">Email Address</label>
                        <input asp-for="Email" class="form-control" placeholder="user@acxiom.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">Send Reset Link</button>
                    <div class="text-center mt-3">
                        <a asp-action="Login" class="small text-decoration-none"><i class="bi bi-arrow-left me-1"></i>Back to Sign In</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
