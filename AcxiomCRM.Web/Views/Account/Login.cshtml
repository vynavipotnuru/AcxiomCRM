@model AcxiomCRM.Application.DTOs.LoginDto
@{
    ViewData["Title"] = "Sign In";
    Layout = "_Layout";
}

<div class="row justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="col-md-5 col-lg-4">
        <div class="text-center mb-4">
            <div class="d-inline-flex align-items-center justify-content-center bg-primary text-white rounded-circle mb-2" style="width: 50px; height: 50px;">
                <i class="bi bi-layers-fill fs-4"></i>
            </div>
            <h3 class="fw-bold">AcxiomCRM</h3>
            <p class="text-muted">Enterprise Sales & Customer Management</p>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h5 class="card-title fw-bold mb-3">Sign in to your account</h5>

                <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-medium small">Email Address</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="form-control" placeholder="name@acxiom.com" autofocus />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <label asp-for="Password" class="form-label fw-medium small mb-0">Password</label>
                            <a asp-action="ForgotPassword" class="small text-decoration-none">Forgot password?</a>
                        </div>
                        <div class="input-group mt-1">
                            <span class="input-group-text bg-light"><i class="bi bi-lock"></i></span>
                            <input asp-for="Password" class="form-control" type="password" placeholder="••••••••" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label small">Remember me</label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">Sign In</button>
                </form>
            </div>
        </div>

        <!-- Quick Demo Credentials Selector -->
        <div class="card border-0 bg-light mt-3">
            <div class="card-body p-3">
                <div class="small fw-bold text-muted mb-2 text-uppercase">Demo Credentials (Password: Acxiom@2026!)</div>
                <div class="d-grid gap-1">
                    <button type="button" class="btn btn-sm btn-outline-secondary text-start" onclick="fillCreds('admin@acxiom.com')">
                        <i class="bi bi-shield-lock-fill text-danger me-1"></i> <strong>Admin:</strong> admin@acxiom.com
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary text-start" onclick="fillCreds('manager@acxiom.com')">
                        <i class="bi bi-person-badge-fill text-primary me-1"></i> <strong>Manager:</strong> manager@acxiom.com
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary text-start" onclick="fillCreds('sales@acxiom.com')">
                        <i class="bi bi-briefcase-fill text-success me-1"></i> <strong>Sales Executive:</strong> sales@acxiom.com
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function fillCreds(email) {
            document.getElementById('Email').value = email;
            document.getElementById('Password').value = 'Acxiom@2026!';
        }
    </script>
}
