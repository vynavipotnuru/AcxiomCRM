@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center text-center py-5">
    <div class="col-md-6">
        <div class="card p-5 border-0 shadow-sm">
            <div class="mb-3">
                <i class="bi bi-shield-lock-fill text-danger" style="font-size: 4rem;"></i>
            </div>
            <h3 class="fw-bold text-danger">Access Denied</h3>
            <p class="text-muted mt-2">
                You do not have the required permissions or role scope to access this page or resource.
                Authorization rules are strictly enforced at the server level.
            </p>
            <div class="mt-4">
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary px-4">
                    <i class="bi bi-arrow-left me-2"></i>Return to Dashboard
                </a>
            </div>
        </div>
    </div>
</div>
