@model List<AcxiomCRM.Application.DTOs.UserDto>
@{
    ViewData["Title"] = "User & Role Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">Users & Access Control</h3>
        <p class="text-muted small mb-0">Manage system operators, assign security roles, and enforce account lockouts.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Role" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-shield-check me-1"></i> View Roles & Permissions
        </a>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-person-plus me-1"></i> Add User
        </a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">User</th>
                        <th>Email Address</th>
                        <th>Role</th>
                        <th>Account Status</th>
                        <th>Lockout</th>
                        <th>Created Date</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="fw-bold text-dark">@u.FullName</div>
                                <div class="small text-muted">@u.PhoneNumber</div>
                            </td>
                            <td>@u.Email</td>
                            <td>
                                @switch (u.Role)
                                {
                                    case "Admin":
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Admin</span>
                                        break;
                                    case "Manager":
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Manager</span>
                                        break;
                                    default:
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Sales Executive</span>
                                        break;
                                }
                            </td>
                            <td>
                                @if (u.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            <td>
                                @if (u.IsLockedOut)
                                {
                                    <span class="badge bg-danger"><i class="bi bi-lock-fill me-1"></i>Locked</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-muted border">Unlocked</span>
                                }
                            </td>
                            <td class="small text-muted">@u.CreatedDate.ToString("MMM dd, yyyy")</td>
                            <td class="text-end pe-4">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-outline-secondary" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="ToggleStatus" asp-route-id="@u.Id" method="post" class="d-inline" onsubmit="return confirm('Change status for this user?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-warning" title="Toggle Active">
                                            <i class="bi @(u.IsActive ? "bi-person-slash" : "bi-person-check")"></i>
                                        </button>
                                    </form>
                                    <button type="button" class="btn btn-outline-info" title="Reset Password" data-bs-toggle="modal" data-bs-target="#resetModal-@u.Id">
                                        <i class="bi bi-key"></i>
                                    </button>
                                </div>

                                <!-- Password Reset Modal -->
                                <div class="modal fade" id="resetModal-@u.Id" tabindex="-1">
                                    <div class="modal-dialog">
                                        <div class="modal-content text-start">
                                            <form asp-action="ResetPassword" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@u.Id" />
                                                <div class="modal-header">
                                                    <h5 class="modal-title">Reset Password for @u.FullName</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <div class="mb-3">
                                                        <label class="form-label small fw-medium">New Password</label>
                                                        <input type="password" name="newPassword" class="form-control" placeholder="••••••••" required minlength="8" />
                                                        <div class="form-text small text-muted">Must be at least 8 characters with upper, lower, number and special char.</div>
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                                                    <button type="submit" class="btn btn-primary">Confirm Reset</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
