@model AcxiomCRM.Application.DTOs.CreateUserDto
@{
    ViewData["Title"] = "Add User";
    var roles = ViewBag.Roles as List<AcxiomCRM.Application.DTOs.RoleDto> ?? new();
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card shadow-sm">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0"><i class="bi bi-person-plus text-primary me-2"></i>Provision Application User</h5>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Back to List</a>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-3"></div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="FullName" class="form-label fw-medium small">Full Name <span class="text-danger">*</span></label>
                            <input asp-for="FullName" class="form-control" placeholder="e.g. Rajesh Kumar" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Email" class="form-label fw-medium small">Corporate Email Address <span class="text-danger">*</span></label>
                            <input asp-for="Email" class="form-control" placeholder="user@acxiom.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="PhoneNumber" class="form-label fw-medium small">Phone Number</label>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="10-digit phone number" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Role" class="form-label fw-medium small">Security Role <span class="text-danger">*</span></label>
                            <select asp-for="Role" class="form-select">
                                @foreach (var r in roles)
                                {
                                    <option value="@r.Name">@r.Name</option>
                                }
                            </select>
                        </div>

                        <div class="col-12">
                            <label asp-for="Password" class="form-label fw-medium small">Initial Password <span class="text-danger">*</span></label>
                            <input asp-for="Password" class="form-control" type="password" placeholder="••••••••" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                            <div class="form-text small text-muted">Password must be at least 8 characters with upper, lower, digit and special character.</div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-action="Index" class="btn btn-light">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-check-lg me-1"></i> Provision User</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
