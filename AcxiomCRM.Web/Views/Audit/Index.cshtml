@model AcxiomCRM.Application.DTOs.PagedResult<AcxiomCRM.Application.DTOs.AuditLogDto>
@{
    ViewData["Title"] = "Security & Audit Trail";
    var searchTerm = ViewBag.SearchTerm as string;
    var entityName = ViewBag.EntityName as string;
    var action = ViewBag.Action as string;
    var fromDate = ViewBag.FromDate as string;
    var toDate = ViewBag.ToDate as string;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">Audit Trail & Security Logs</h3>
        <p class="text-muted small mb-0">Immutable records of authentication events, CRUD operations, status changes, and administrative actions.</p>
    </div>
</div>

<!-- Filter Card -->
<div class="card mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-3">
                <input type="text" name="searchTerm" value="@searchTerm" class="form-control" placeholder="Search user, details, record ID..." />
            </div>
            <div class="col-md-2">
                <select name="entityName" class="form-select">
                    <option value="">All Modules</option>
                    <option value="Authentication" selected="@(entityName == "Authentication")">Authentication</option>
                    <option value="Customer" selected="@(entityName == "Customer")">Customer</option>
                    <option value="Lead" selected="@(entityName == "Lead")">Lead</option>
                    <option value="Opportunity" selected="@(entityName == "Opportunity")">Opportunity</option>
                    <option value="FollowUp" selected="@(entityName == "FollowUp")">FollowUp</option>
                    <option value="Activity" selected="@(entityName == "Activity")">Activity</option>
                    <option value="User" selected="@(entityName == "User")">User</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="action" class="form-select">
                    <option value="">All Actions</option>
                    <option value="Login" selected="@(action == "Login")">Login</option>
                    <option value="FailedLogin" selected="@(action == "FailedLogin")">FailedLogin</option>
                    <option value="Logout" selected="@(action == "Logout")">Logout</option>
                    <option value="Create" selected="@(action == "Create")">Create</option>
                    <option value="Update" selected="@(action == "Update")">Update</option>
                    <option value="Delete" selected="@(action == "Delete")">Delete</option>
                    <option value="Convert" selected="@(action == "Convert")">Convert</option>
                    <option value="StatusChange" selected="@(action == "StatusChange")">StatusChange</option>
                    <option value="Reschedule" selected="@(action == "Reschedule")">Reschedule</option>
                </select>
            </div>
            <div class="col-md-2">
                <input type="date" name="fromDate" value="@fromDate" class="form-control" title="From Date" />
            </div>
            <div class="col-md-2">
                <input type="date" name="toDate" value="@toDate" class="form-control" title="To Date" />
            </div>
            <div class="col-md-1 d-flex gap-1">
                <button type="submit" class="btn btn-secondary w-100" title="Apply Filter"><i class="bi bi-funnel"></i></button>
            </div>
        </form>
    </div>
</div>

<!-- Audit Log Table -->
<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 font-monospace small">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Timestamp (UTC)</th>
                        <th>User</th>
                        <th>Module</th>
                        <th>Action</th>
                        <th>Record ID</th>
                        <th>Result</th>
                        <th>Details</th>
                        <th class="pe-4">IP Address</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Any())
                    {
                        @foreach (var log in Model.Items)
                        {
                            <tr>
                                <td class="ps-4 text-nowrap">@log.CreatedDate.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td class="fw-bold">@(log.UserName ?? "Anonymous")</td>
                                <td><span class="badge bg-secondary-subtle text-secondary border">@log.EntityName</span></td>
                                <td>
                                    @switch (log.Action)
                                    {
                                        case "Login":
                                        case "ApiLogin":
                                            <span class="badge bg-success-subtle text-success">@log.Action</span>
                                            break;
                                        case "FailedLogin":
                                        case "ApiFailedLogin":
                                            <span class="badge bg-danger-subtle text-danger">@log.Action</span>
                                            break;
                                        case "Create":
                                            <span class="badge bg-primary-subtle text-primary">Create</span>
                                            break;
                                        case "Update":
                                            <span class="badge bg-warning-subtle text-warning">Update</span>
                                            break;
                                        case "Delete":
                                            <span class="badge bg-danger">Delete</span>
                                            break;
                                        case "Convert":
                                            <span class="badge bg-info-subtle text-info">Convert</span>
                                            break;
                                        default:
                                            <span class="badge bg-light text-dark border">@log.Action</span>
                                            break;
                                    }
                                </td>
                                <td>@(log.RecordId ?? "-")</td>
                                <td>
                                    <span class="badge @(log.Result == "Success" ? "bg-success" : log.Result == "LockedOut" ? "bg-danger" : "bg-warning text-dark")">@log.Result</span>
                                </td>
                                <td>
                                    <div class="text-truncate" style="max-width: 320px;" title="@log.Details">
                                        @log.Details
                                    </div>
                                    @if (!string.IsNullOrEmpty(log.OldValue) || !string.IsNullOrEmpty(log.NewValue))
                                    {
                                        <div class="text-muted text-truncate" style="max-width: 320px; font-size: 0.75rem;">
                                            <span>Old: @log.OldValue</span> | <span>New: @log.NewValue</span>
                                        </div>
                                    }
                                </td>
                                <td class="pe-4 text-muted">@log.IpAddress</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-shield-check fs-2"></i>
                                <p class="mt-2 mb-0">No audit log records found for current criteria.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
            <span class="small text-muted">Showing page @Model.PageIndex of @Model.TotalPages (@Model.TotalCount total records)</span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pageIndex="@(Model.PageIndex - 1)" asp-route-searchTerm="@searchTerm" asp-route-entityName="@entityName" asp-route-action="@action" asp-route-fromDate="@fromDate" asp-route-toDate="@toDate">Previous</a>
                </li>
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.PageIndex ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-pageIndex="@p" asp-route-searchTerm="@searchTerm" asp-route-entityName="@entityName" asp-route-action="@action" asp-route-fromDate="@fromDate" asp-route-toDate="@toDate">@p</a>
                    </li>
                }
                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pageIndex="@(Model.PageIndex + 1)" asp-route-searchTerm="@searchTerm" asp-route-entityName="@entityName" asp-route-action="@action" asp-route-fromDate="@fromDate" asp-route-toDate="@toDate">Next</a>
                </li>
            </ul>
        </div>
    }
</div>
