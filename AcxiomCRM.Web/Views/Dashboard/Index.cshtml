@model AcxiomCRM.Application.DTOs.DashboardSummaryDto
@{
    ViewData["Title"] = "Executive Dashboard";
    var currentFilter = ViewBag.ActiveDateFilter as string ?? "All";
}

<!-- Dashboard Header & Date Filters -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h3 class="fw-bold mb-1">Sales & CRM Dashboard</h3>
        <p class="text-muted mb-0 small">Overview of pipeline metrics, active leads, and recent activities.</p>
    </div>
    <div class="btn-group shadow-sm" role="group">
        <a asp-action="Index" asp-route-dateFilter="All" class="btn btn-sm @(currentFilter == "All" ? "btn-primary" : "btn-outline-secondary")">All Time</a>
        <a asp-action="Index" asp-route-dateFilter="Today" class="btn btn-sm @(currentFilter == "Today" ? "btn-primary" : "btn-outline-secondary")">Today</a>
        <a asp-action="Index" asp-route-dateFilter="ThisWeek" class="btn btn-sm @(currentFilter == "ThisWeek" ? "btn-primary" : "btn-outline-secondary")">This Week</a>
        <a asp-action="Index" asp-route-dateFilter="ThisMonth" class="btn btn-sm @(currentFilter == "ThisMonth" ? "btn-primary" : "btn-outline-secondary")">This Month</a>
    </div>
</div>

<!-- 8 Mandatory KPI Cards -->
<div class="row g-3 mb-4">
    <!-- Total Customers -->
    <div class="col-sm-6 col-xl-3">
        <div class="card h-100 kpi-card p-3 border-start border-4 border-primary">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Total Customers</span>
                    <h3 class="fw-bold my-1 text-dark">@Model.TotalCustomers</h3>
                    <span class="small text-muted"><i class="bi bi-people me-1"></i>Master clients</span>
                </div>
                <div class="bg-primary-subtle text-primary p-3 rounded-circle">
                    <i class="bi bi-building fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Total Leads -->
    <div class="col-sm-6 col-xl-3">
        <div class="card h-100 kpi-card p-3 border-start border-4 border-info">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Total Leads</span>
                    <h3 class="fw-bold my-1 text-dark">@Model.TotalLeads</h3>
                    <span class="small text-info fw-medium"><i class="bi bi-funnel me-1"></i>Prospects</span>
                </div>
                <div class="bg-info-subtle text-info p-3 rounded-circle">
                    <i class="bi bi-person-lines-fill fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Open Leads -->
    <div class="col-sm-6 col-xl-3">
        <div class="card h-100 kpi-card p-3 border-start border-4 border-warning">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Open Leads</span>
                    <h3 class="fw-bold my-1 text-dark">@Model.OpenLeads</h3>
                    <span class="small text-muted">In qualification</span>
                </div>
                <div class="bg-warning-subtle text-warning p-3 rounded-circle">
                    <i class="bi bi-hourglass-split fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Total Opportunities -->
    <div class="col-sm-6 col-xl-3">
        <div class="card h-100 kpi-card p-3 border-start border-4 border-secondary">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Total Opps</span>
                    <h3 class="fw-bold my-1 text-dark">@Model.TotalOpportunities</h3>
                    <span class="small text-muted">In pipeline</span>
                </div>
                <div class="bg-secondary-subtle text-secondary p-3 rounded-circle">
                    <i class="bi bi-briefcase fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Open Opportunities -->
    <div class="col-sm-6 col-xl-3">
        <div class="card h-100 kpi-card p-3 border-start border-4 border-primary">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Open Opps</span>
                    <h3 class="fw-bold my-1 text-dark">@Model.OpenOpportunities</h3>
                    <span class="small text-primary fw-medium">Active negotiations</span>
                </div>
                <div class="bg-primary-subtle text-primary p-3 rounded-circle">
                    <i class="bi bi-kanban fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Won Opportunities -->
    <div class="col-sm-6 col-xl-3">
        <div class="card h-100 kpi-card p-3 border-start border-4 border-success">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Won Deals</span>
                    <h3 class="fw-bold my-1 text-success">@Model.WonOpportunities</h3>
                    <span class="small text-success fw-medium"><i class="bi bi-trophy me-1"></i>Closed Won</span>
                </div>
                <div class="bg-success-subtle text-success p-3 rounded-circle">
                    <i class="bi bi-check2-circle fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Lost Opportunities -->
    <div class="col-sm-6 col-xl-3">
        <div class="card h-100 kpi-card p-3 border-start border-4 border-danger">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Lost Deals</span>
                    <h3 class="fw-bold my-1 text-danger">@Model.LostOpportunities</h3>
                    <span class="small text-muted">Closed Lost</span>
                </div>
                <div class="bg-danger-subtle text-danger p-3 rounded-circle">
                    <i class="bi bi-x-circle fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Total Pipeline Value -->
    <div class="col-sm-6 col-xl-3">
        <div class="card h-100 kpi-card p-3 border-start border-4 border-dark bg-dark text-white">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-light-50 small fw-semibold text-uppercase">Pipeline Value</span>
                    <h3 class="fw-bold my-1 text-white">₹@Model.TotalPipelineValue.ToString("N0")</h3>
                    <span class="small text-success fw-medium"><i class="bi bi-graph-up me-1"></i>Active Pipeline</span>
                </div>
                <div class="bg-white bg-opacity-10 p-3 rounded-circle text-white">
                    <i class="bi bi-cash-stack fs-4"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Mandatory Chart.js Visualizations -->
<div class="row g-4 mb-4">
    <!-- Chart 1: Opportunity Pipeline -->
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header bg-white py-3 border-bottom">
                <h6 class="fw-bold mb-0"><i class="bi bi-pie-chart-fill text-primary me-2"></i>Lead Status Breakdown</h6>
            </div>
            <div class="card-body d-flex align-items-center justify-content-center p-3">
                <div style="width: 280px; height: 280px;">
                    <canvas id="leadStatusChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Chart 2: Pipeline by Stage -->
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header bg-white py-3 border-bottom">
                <h6 class="fw-bold mb-0"><i class="bi bi-bar-chart-fill text-primary me-2"></i>Opportunity Pipeline by Stage (₹)</h6>
            </div>
            <div class="card-body p-3">
                <canvas id="pipelineStageChart" style="max-height: 280px;"></canvas>
            </div>
        </div>
    </div>

    <!-- Chart 3: Monthly Sales -->
    <div class="col-12">
        <div class="card">
            <div class="card-header bg-white py-3 border-bottom">
                <h6 class="fw-bold mb-0"><i class="bi bi-graph-up-arrow text-success me-2"></i>Monthly Sales Revenue / Closed Won Performance (Last 6 Months)</h6>
            </div>
            <div class="card-body p-3">
                <canvas id="monthlySalesChart" style="max-height: 250px;"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Operational Feeds: Upcoming Follow-ups & Recent Activities -->
<div class="row g-4">
    <!-- Upcoming Follow-Ups -->
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0"><i class="bi bi-calendar-event text-warning me-2"></i>Upcoming Follow-Ups</h6>
                <a asp-controller="FollowUp" asp-action="Index" class="btn btn-sm btn-outline-primary">View All</a>
            </div>
            <div class="card-body p-0">
                @if (Model.UpcomingFollowUps.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var f in Model.UpcomingFollowUps)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                                <div>
                                    <div class="fw-bold text-dark">@f.Subject</div>
                                    <div class="small text-muted">
                                        <i class="bi bi-tag me-1"></i>@(f.CustomerName ?? f.LeadName ?? "General") •
                                        <i class="bi bi-clock me-1"></i>@f.FollowUpDate.ToString("MMM dd, yyyy HH:mm")
                                    </div>
                                </div>
                                <span class="badge bg-primary-subtle text-primary">@f.FollowUpType</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center p-4 text-muted">
                        <i class="bi bi-calendar-check fs-2 text-muted"></i>
                        <p class="mb-0 mt-2 small">No upcoming follow-ups scheduled.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Recent Activities -->
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0"><i class="bi bi-clock-history text-info me-2"></i>Recent CRM Activities</h6>
                <a asp-controller="Activity" asp-action="Index" class="btn btn-sm btn-outline-primary">View All</a>
            </div>
            <div class="card-body p-0">
                @if (Model.RecentActivities.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var a in Model.RecentActivities)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                                <div>
                                    <div class="fw-semibold">@a.Subject</div>
                                    <div class="small text-muted">
                                        <i class="bi bi-person me-1"></i>@(a.CustomerName ?? a.LeadName ?? "General") •
                                        @a.ActivityDate.ToString("MMM dd, yyyy")
                                    </div>
                                </div>
                                <span class="badge bg-secondary-subtle text-secondary">@a.ActivityType</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center p-4 text-muted">
                        <i class="bi bi-inbox fs-2 text-muted"></i>
                        <p class="mb-0 mt-2 small">No recent activity recorded.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Chart 1: Lead Status
            var leadLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LeadStatusChart.Labels));
            var leadData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LeadStatusChart.Data));
            var leadColors = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LeadStatusChart.BackgroundColors));

            new Chart(document.getElementById('leadStatusChart'), {
                type: 'doughnut',
                data: {
                    labels: leadLabels,
                    datasets: [{
                        data: leadData,
                        backgroundColor: leadColors
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom' }
                    }
                }
            });

            // Chart 2: Pipeline by Stage
            var oppLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.OpportunityPipelineChart.Labels));
            var oppData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.OpportunityPipelineChart.Data));
            var oppColors = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.OpportunityPipelineChart.BackgroundColors));

            new Chart(document.getElementById('pipelineStageChart'), {
                type: 'bar',
                data: {
                    labels: oppLabels,
                    datasets: [{
                        label: 'Stage Value (₹)',
                        data: oppData,
                        backgroundColor: oppColors,
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(value) { return '₹' + value.toLocaleString(); }
                            }
                        }
                    }
                }
            });

            // Chart 3: Monthly Sales
            var salesLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlySalesChart.Labels));
            var salesData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlySalesChart.Data));

            new Chart(document.getElementById('monthlySalesChart'), {
                type: 'line',
                data: {
                    labels: salesLabels,
                    datasets: [{
                        label: 'Closed Won Revenue (₹)',
                        data: salesData,
                        borderColor: '#10b981',
                        backgroundColor: 'rgba(16, 185, 129, 0.1)',
                        fill: true,
                        tension: 0.3
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(value) { return '₹' + value.toLocaleString(); }
                            }
                        }
                    }
                }
            });
        });
    </script>
}
