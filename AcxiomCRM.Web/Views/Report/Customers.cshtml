@model List<AcxiomCRM.Application.DTOs.CustomerReportDto>
@{
    ViewData["Title"] = "Customer Report";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">Customer Report</h3>
        <p class="text-muted small mb-0">Complete list of registered client organizations, contact points and statuses.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">Back to Reports</a>
        <button onclick="window.print()" class="btn btn-primary"><i class="bi bi-printer me-1"></i> Print / Export</button>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Code</th>
                        <th>Customer Name</th>
                        <th>Company</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Status</th>
                        <th>Created Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold text-primary">@c.CustomerCode</td>
                            <td class="fw-bold">@c.CustomerName</td>
                            <td>@(c.CompanyName ?? "-")</td>
                            <td>@c.Email</td>
                            <td>@c.Phone</td>
                            <td><span class="badge @(c.Status == "Active" ? "bg-success" : "bg-secondary")">@c.Status</span></td>
                            <td class="small text-muted">@c.CreatedDate.ToString("MMM dd, yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
