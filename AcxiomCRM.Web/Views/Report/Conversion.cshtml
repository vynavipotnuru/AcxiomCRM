@model AcxiomCRM.Application.DTOs.ConversionReportDto
@{
    ViewData["Title"] = "Conversion Report";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">Lead Conversion & Outcome Report</h3>
        <p class="text-muted small mb-0">Conversion funnel performance, conversion rates, and outcome analysis.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">Back to Reports</a>
        <button onclick="window.print()" class="btn btn-primary"><i class="bi bi-printer me-1"></i> Print / Export</button>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-sm-6 col-lg-3">
        <div class="card p-3 border-start border-4 border-primary shadow-sm">
            <span class="text-muted small text-uppercase fw-semibold">Total Prospects</span>
            <h3 class="fw-bold my-1 text-dark">@Model.TotalLeads</h3>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card p-3 border-start border-4 border-success shadow-sm">
            <span class="text-muted small text-uppercase fw-semibold">Converted to Clients</span>
            <h3 class="fw-bold my-1 text-success">@Model.ConvertedLeads</h3>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card p-3 border-start border-4 border-danger shadow-sm">
            <span class="text-muted small text-uppercase fw-semibold">Lost Leads</span>
            <h3 class="fw-bold my-1 text-danger">@Model.LostLeads</h3>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card p-3 border-start border-4 border-info shadow-sm">
            <span class="text-muted small text-uppercase fw-semibold">Conversion Rate</span>
            <h3 class="fw-bold my-1 text-primary">@Model.ConversionRatePercentage%</h3>
        </div>
    </div>
</div>

<div class="card shadow-sm p-4 text-center">
    <h5 class="fw-bold mb-3">Sales Conversion Funnel</h5>
    <div class="progress" style="height: 30px;">
        @{
            var convPercent = Model.TotalLeads > 0 ? (Model.ConvertedLeads * 100) / Model.TotalLeads : 0;
            var openPercent = Model.TotalLeads > 0 ? (Model.OpenLeads * 100) / Model.TotalLeads : 0;
            var lostPercent = Model.TotalLeads > 0 ? (Model.LostLeads * 100) / Model.TotalLeads : 0;
        }
        <div class="progress-bar bg-success" role="progressbar" style="width: @convPercent%;" title="Converted: @convPercent%">Converted (@convPercent%)</div>
        <div class="progress-bar bg-warning" role="progressbar" style="width: @openPercent%;" title="In Pipeline: @openPercent%">In Pipeline (@openPercent%)</div>
        <div class="progress-bar bg-danger" role="progressbar" style="width: @lostPercent%;" title="Lost: @lostPercent%">Lost (@lostPercent%)</div>
    </div>
</div>
