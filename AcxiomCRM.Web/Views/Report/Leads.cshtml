@model List<AcxiomCRM.Application.DTOs.LeadReportDto>
@{
    ViewData["Title"] = "Lead Report";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">Lead & Prospect Report</h3>
        <p class="text-muted small mb-0">Lead source distribution, estimated potential, and current qualification stages.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">Back to Reports</a>
        <button onclick="window.print()" class="btn btn-primary"><i class="bi bi-printer me-1"></i> Print / Export</button>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Code</th>
                        <th>Lead Name</th>
                        <th>Company</th>
                        <th>Source</th>
                        <th>Status</th>
                        <th>Expected Value</th>
                        <th>Created Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold text-primary">@l.LeadCode</td>
                            <td class="fw-bold">@l.LeadName</td>
                            <td>@(l.CompanyName ?? "-")</td>
                            <td><span class="badge bg-light text-dark border">@(l.Source ?? "Direct")</span></td>
                            <td>
                                <span class="badge @(l.Status == "Converted" ? "bg-success" : l.Status == "Lost" ? "bg-danger" : "bg-primary")">@l.Status</span>
                            </td>
                            <td class="fw-bold">₹@l.ExpectedValue.ToString("N0")</td>
                            <td class="small text-muted">@l.CreatedDate.ToString("MMM dd, yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
