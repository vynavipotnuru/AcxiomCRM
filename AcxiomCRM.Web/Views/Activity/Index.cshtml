@model List<AcxiomCRM.Application.DTOs.ActivityDto>
@{
    ViewData["Title"] = "Activity Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">Activities</h3>
        <p class="text-muted small mb-0">Record and review customer interactions including Calls, Meetings, Emails and Tasks.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-chat-left-dots me-1"></i> Log Activity
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white py-3">
        <h6 class="fw-bold mb-0"><i class="bi bi-clock-history text-primary me-2"></i>Recent Activity Stream</h6>
    </div>
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <div class="list-group list-group-flush">
                @foreach (var a in Model)
                {
                    <div class="list-group-item p-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="badge bg-primary-subtle text-primary border">@a.ActivityType</span>
                            <span class="small text-muted"><i class="bi bi-calendar3 me-1"></i>@a.ActivityDate.ToString("MMM dd, yyyy HH:mm")</span>
                        </div>
                        <h6 class="fw-bold mb-1 text-dark">@a.Subject</h6>
                        <div class="small text-muted mb-2">
                            @if (!string.IsNullOrEmpty(a.CustomerName))
                            {
                                <span><i class="bi bi-building me-1"></i>Customer: @a.CustomerName</span>
                            }
                            else if (!string.IsNullOrEmpty(a.LeadName))
                            {
                                <span><i class="bi bi-person me-1"></i>Lead: @a.LeadName</span>
                            }
                            else
                            {
                                <span>General Interaction</span>
                            }
                        </div>
                        <p class="small text-secondary mb-0">@(a.Description ?? "No additional description.")</p>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center p-5 text-muted">
                <i class="bi bi-inbox fs-2"></i>
                <p class="mt-2 mb-0">No activities recorded yet.</p>
            </div>
        }
    </div>
</div>
