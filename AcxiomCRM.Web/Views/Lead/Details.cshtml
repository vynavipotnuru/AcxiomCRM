@model AcxiomCRM.Application.DTOs.LeadDto
@{
    ViewData["Title"] = $"Lead Details - {Model.LeadName}";
    var activities = ViewBag.Activities as List<AcxiomCRM.Application.DTOs.ActivityDto> ?? new();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h3 class="fw-bold mb-0">@Model.LeadName</h3>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">@Model.LeadCode</span>
            <span class="badge bg-info-subtle text-info">@Model.Status</span>
        </div>
        <p class="text-muted small mb-0 mt-1"><i class="bi bi-building me-1"></i>@(Model.CompanyName ?? "Individual") • Created on @Model.CreatedDate.ToString("MMM dd, yyyy")</p>
    </div>
    <div class="d-flex gap-2">
        @if (Model.Status != LeadStatus.Converted)
        {
            <a asp-action="Convert" asp-route-id="@Model.LeadId" class="btn btn-sm btn-success">
                <i class="bi bi-arrow-right-circle me-1"></i> Convert Lead
            </a>
            <a asp-controller="FollowUp" asp-action="Create" asp-route-leadId="@Model.LeadId" class="btn btn-sm btn-outline-primary">
                <i class="bi bi-calendar-plus me-1"></i> Follow-Up
            </a>
            <a asp-controller="Activity" asp-action="Create" asp-route-leadId="@Model.LeadId" class="btn btn-sm btn-outline-info">
                <i class="bi bi-chat-left-text me-1"></i> Log Activity
            </a>
            <a asp-action="Edit" asp-route-id="@Model.LeadId" class="btn btn-sm btn-secondary">
                <i class="bi bi-pencil me-1"></i> Edit
            </a>
        }
        else
        {
            <span class="badge bg-success p-2 fs-6"><i class="bi bi-check-circle me-1"></i> Converted on @Model.ConvertedDate?.ToString("MMM dd, yyyy")</span>
        }
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white py-3">
                <h6 class="fw-bold mb-0"><i class="bi bi-info-circle text-primary me-2"></i>Lead Information</h6>
            </div>
            <div class="card-body">
                <ul class="list-unstyled mb-0">
                    <li class="mb-3">
                        <span class="text-muted small d-block">Email Address</span>
                        <a href="mailto:@Model.Email" class="text-decoration-none fw-medium">@Model.Email</a>
                    </li>
                    <li class="mb-3">
                        <span class="text-muted small d-block">Phone Number</span>
                        <span class="fw-medium">@Model.Phone</span>
                    </li>
                    <li class="mb-3">
                        <span class="text-muted small d-block">Company</span>
                        <span class="fw-medium">@(Model.CompanyName ?? "N/A")</span>
                    </li>
                    <li class="mb-3">
                        <span class="text-muted small d-block">Lead Source</span>
                        <span class="badge bg-light text-dark border">@(Model.Source ?? "Direct")</span>
                    </li>
                    <li class="mb-3">
                        <span class="text-muted small d-block">Priority</span>
                        <span class="badge bg-warning text-dark">@Model.Priority</span>
                    </li>
                    <li class="mb-0">
                        <span class="text-muted small d-block">Notes</span>
                        <p class="small mb-0 text-secondary">@(string.IsNullOrEmpty(Model.Notes) ? "No notes recorded." : Model.Notes)</p>
                    </li>
                </ul>
            </div>
        </div>

        <div class="card shadow-sm border-start border-4 border-warning">
            <div class="card-body p-3">
                <span class="text-muted small text-uppercase fw-semibold">Expected Value</span>
                <h4 class="fw-bold my-1 text-dark">₹@Model.ExpectedValue.ToString("N0")</h4>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header bg-white py-3">
                <h6 class="fw-bold mb-0"><i class="bi bi-clock-history text-primary me-2"></i>Activity History</h6>
            </div>
            <div class="card-body p-0">
                @if (activities.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var act in activities)
                        {
                            <div class="list-group-item p-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="badge bg-primary-subtle text-primary">@act.ActivityType</span>
                                    <span class="small text-muted">@act.ActivityDate.ToString("MMM dd, yyyy HH:mm")</span>
                                </div>
                                <h6 class="fw-bold mb-1">@act.Subject</h6>
                                <p class="small text-muted mb-0">@(act.Description ?? "No description recorded.")</p>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center p-5 text-muted">
                        <i class="bi bi-chat-square-dots fs-1"></i>
                        <p class="mt-2 mb-0">No activities recorded for this lead.</p>
                        <a asp-controller="Activity" asp-action="Create" asp-route-leadId="@Model.LeadId" class="btn btn-sm btn-outline-primary mt-3">Log First Activity</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
